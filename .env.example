# Copy to .env for local dev. On Railway, set these as service variables instead.

# Must be a database ONLY this service uses — the whole point of splitting
# this out was to stop sharing a failure domain with cungus's backend. Either
# a brand-new Postgres instance, or a separate database on an existing
# Postgres server — not mambru-backend's DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/veynor

PORT=4300

# Added 2026-09-05 — only needed to run scripts/notify-waitlist.js (emailing
# the waitlist real updates). Optional for the server itself: the app keeps
# collecting signups fine without these, the script just refuses to send.
# Same pattern mambru-backend already uses for its own EMAIL_USER/EMAIL_PASS
# (2AM's drop-notify system) — if Chris already set those up there, the exact
# same Gmail address + App Password work here too, no new setup needed.
# EMAIL_USER = a real Gmail address.
# EMAIL_PASS = a Gmail App Password (NOT the real account password) — create
#   one at https://myaccount.google.com/apppasswords (needs 2-Step
#   Verification turned on first, which is a good idea regardless).
EMAIL_USER=
EMAIL_PASS=
