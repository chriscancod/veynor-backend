# Copy to .env for local dev. On Railway, set these as service variables instead.

# Must be a database ONLY this service uses — the whole point of splitting
# this out was to stop sharing a failure domain with cungus's backend. Either
# a brand-new Postgres instance, or a separate database on an existing
# Postgres server — not mambru-backend's DATABASE_URL.
DATABASE_URL=postgres://user:password@host:5432/veynor

PORT=4300
